// First-slice schema.
// Table 4 body stays in ProformaVersion.payload until the official format is confirmed.
// Child academic tables (CLO, PLO rows, topics, teaching plan, activities, SLT,
// assessments) are intentionally omitted from this slice.
//
// Deliberate decisions locked for this slice:
// - onDelete: Restrict on every relation. Nothing in this domain should be
//   hard-deletable via cascade (courses, users, versions, audit trail).
//   Deactivate with isActive / status changes instead of deleting rows.
// - PUBLISHED uniqueness (one published version per course) and the
//   NULL-safe UserRole uniqueness are enforced by hand-written partial
//   unique indexes, since Prisma's schema DSL cannot express partial
//   (WHERE-clause) unique indexes. See prisma/manual-fixes.sql — append
//   its contents to your first migration.sql before applying (see that
//   file's header for the exact steps).
// - versionNo generation must happen inside a serializable transaction —
//   see lib/proforma-version.ts. Do not compute MAX(versionNo)+1 outside
//   a transaction; two simultaneous "create draft" calls will collide.

// - Second slice: real Table 4 structure (CLO, CLO-PLO mapping, weekly
//   topics/SLT, assessment items) now confirmed against UKM's official
//   Table 4 v2.0 (June 2020, PPPK update 26.6.2024) — see ProgrammePlo,
//   CourseLearningOutcome, CloPloMapping, CourseTopic, AssessmentItem
//   below, plus the new scalar fields on ProformaVersion. The old
//   `payload` JSON field stays as a catch-all for anything not yet
//   modelled (or captured before this slice existed).
// - SLT hours per topic/assessment are stored as a simplified 3-number
//   JSON ({f2fPhysical, f2fOnline, independent}) rather than the
//   official form's full 8-cell L/T/P/O × mode breakdown. This is
//   enough to compute the two headline ODL percentages (A: %F2F
//   Physical, B: %Online+Independent) but NOT the Practical-component
//   breakdown (C/C1/C2), which needs the L/T/P/O split we dropped.
//   Flagged as a known simplification — revisit if FTSM confirms C/C1/C2
//   must be tracked.
// - CloPloMapping.clo uses onDelete: Cascade (the one deliberate
//   exception to the no-cascade rule above): a mapping tick has no
//   meaning once its CLO is deleted mid-edit, and forcing someone to
//   manually unmap every PLO before deleting a CLO from a draft would
//   be painful UX for no safety benefit. CloPloMapping.programmePlo
//   stays Restrict — deleting a programme-wide PLO that's actively
//   mapped anywhere should still be blocked.

enum CourseClassification {
  WU_CITRA_WAJIB
  WU_CITRA_RENTAS
  TERAS
  ELEKTIF
  AUDIT
}

enum AssessmentPhase {
  CONTINUOUS
  FINAL
}

// Bloom's/Simpson's taxonomy domain used to classify a CLO's verb —
// Cognitive (K1-K6, coded C1-C6), Affective (A1-A5), Psychomotor
// (P1-P7). This is a DIFFERENT classification from MQF Cluster
// (mqfClusters below) — see the UKM "Panduan Pemetaan Kluster..."
// and taxonomy verb-table references. The inline "(C4; PLO2)" style
// annotation seen on official Table 4 documents comes from this.
enum TaxonomyDomain {
  KOGNITIF
  AFEKTIF
  PSIKOMOTOR
}

model ProgrammePlo {
  id          String   @id @default(cuid())
  programmeId String
  orderNumber Int
  textMs      String
  textEn      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  mappings  CloPloMapping[]

  @@unique([programmeId, orderNumber])
  @@index([programmeId])
}

model CourseLearningOutcome {
  id                String   @id @default(cuid())
  versionId         String
  orderIndex        Int
  text              String
  teachingMethods   String?
  assessmentMethods String?
  mqfClusters       String[]
  taxonomyDomain    TaxonomyDomain?
  taxonomyLevel     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  version  ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  mappings CloPloMapping[]

  @@unique([versionId, orderIndex])
  @@index([versionId])
}

model CloPloMapping {
  id             String @id @default(cuid())
  cloId          String
  programmePloId String

  clo          CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)
  programmePlo ProgrammePlo          @relation(fields: [programmePloId], references: [id], onDelete: Restrict)

  @@unique([cloId, programmePloId])
  @@index([programmePloId])
}

model CourseTopic {
  id         String   @id @default(cuid())
  versionId  String
  orderIndex Int
  topicMs    String
  topicEn    String?
  cloRef     String?
  hours      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, orderIndex])
  @@index([versionId])
}

model AssessmentItem {
  id               String          @id @default(cuid())
  versionId        String
  phase            AssessmentPhase
  orderIndex       Int
  nameMs           String
  nameEn           String?
  weightagePercent Decimal?        @db.Decimal(5, 2)
  hours            Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, phase, orderIndex])
  @@index([versionId])
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FACULTY_OFFICER
  PROGRAMME_COORDINATOR
  COURSE_COORDINATOR
  LECTURER
}

enum ProformaStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum ReviewActionType {
  SUBMIT
  REQUEST_CHANGES
  APPROVE
  PUBLISH
  ARCHIVE
  REOPEN_DRAFT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  staffNo      String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles             UserRole[]
  assignments       CourseAssignment[]
  versionsCreated   ProformaVersion[]  @relation("VersionCreatedBy")
  reviewActions     ReviewAction[]
  comments          ReviewComment[]
  auditEvents       AuditEvent[]
}

model UserRole {
  id          String     @id @default(cuid())
  userId      String
  role        Role
  programmeId String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  // NOTE: @@unique([userId, role, programmeId]) does NOT stop duplicate
  // (userId, role) rows when programmeId is NULL, because PostgreSQL treats
  // every NULL as distinct for uniqueness purposes. This constraint only
  // protects programme-scoped roles (e.g. two PROGRAMME_COORDINATOR rows
  // for the same user + same programme).
  //
  // A second, partial unique index covers the NULL case (faculty-wide
  // roles like ADMIN, FACULTY_OFFICER, LECTURER) — see
  // prisma/migrations/00000000000000_manual_fixes/migration.sql
  @@unique([userId, role, programmeId])
  @@index([role])
}

model Programme {
  id        String   @id @default(cuid())
  code      String   @unique
  nameMs    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  userRoles UserRole[]
  plos      ProgrammePlo[]
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  nameMs      String
  nameEn      String?
  creditHours Decimal  @db.Decimal(4, 1)
  programmeId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  assignments CourseAssignment[]
  versions    ProformaVersion[]

  @@index([programmeId])
}

model CourseAssignment {
  id            String   @id @default(cuid())
  courseId      String
  userId        String
  isCoordinator Boolean  @default(false)
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@index([userId])
}

model ProformaVersion {
  id                  String         @id @default(cuid())
  courseId            String
  versionNo           Int
  status              ProformaStatus @default(DRAFT)
  schemaFormatVersion Int            @default(1)
  payload             Json           @default("{}")
  createdById         String
  submittedAt         DateTime?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // ---- Table 4 structured fields (v2.0 UKM format) ----------------
  synopsis                String?
  academicStaffNames      String[]
  yearOffered             Int?
  semesterOffered         Int?
  offeringRemarks         String?
  prerequisite            String?
  classification          CourseClassification?
  classificationDomain    String?
  transferableSkills      String[]
  specialRequirements     String?
  referencesText          String?
  futureReadyElements     String[]
  excelFramework          String[]
  sdgTags                 String[]
  aiElement                Boolean  @default(false)
  isIndustrialTraining50Elt Boolean @default(false)
  facultyApprovalDate     DateTime?
  senateApprovalDate      DateTime?

  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewActions ReviewAction[]
  comments      ReviewComment[]
  auditEvents   AuditEvent[]
  clos          CourseLearningOutcome[]
  topics        CourseTopic[]
  assessments   AssessmentItem[]

  @@unique([courseId, versionNo])
  @@index([status])
  @@index([courseId, status])
}

model ReviewAction {
  id        String           @id @default(cuid())
  versionId String
  actorId   String
  type      ReviewActionType
  note      String?
  createdAt DateTime         @default(now())

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor   User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([actorId])
}

model ReviewComment {
  id         String   @id @default(cuid())
  versionId  String
  authorId   String
  sectionKey String?
  body       String
  createdAt  DateTime @default(now())

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([versionId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  versionId  String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor   User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version ProformaVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

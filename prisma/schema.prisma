enum CourseClassification {
  WU_CITRA_WAJIB
  WU_CITRA_RENTAS
  TERAS
  ELEKTIF
  AUDIT
}

enum AssessmentPhase {
  CONTINUOUS
  FINAL
}

enum TaxonomyDomain {
  KOGNITIF
  AFEKTIF
  PSIKOMOTOR
}

model ProgrammePlo {
  id          String   @id @default(cuid())
  programmeId String
  orderNumber Int
  textMs      String
  textEn      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  mappings  CloPloMapping[]

  @@unique([programmeId, orderNumber])
  @@index([programmeId])
}

model CourseLearningOutcome {
  id                String   @id @default(cuid())
  versionId         String
  orderIndex        Int
  text              String
  teachingMethods   String?
  assessmentMethods String?
  mqfClusters       String[]
  taxonomyDomain    TaxonomyDomain?
  taxonomyLevel     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  version       ProformaVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  mappings      CloPloMapping[]
  topicMappings TopicCloMapping[]

  @@unique([versionId, orderIndex])
  @@index([versionId])
}

model CloPloMapping {
  id             String @id @default(cuid())
  cloId          String
  programmePloId String

  clo          CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)
  programmePlo ProgrammePlo          @relation(fields: [programmePloId], references: [id], onDelete: Restrict)

  @@unique([cloId, programmePloId])
  @@index([programmePloId])
}

model CourseTopic {
  id         String   @id @default(cuid())
  versionId  String
  orderIndex Int
  topicMs    String
  topicEn    String?
  // Legacy field retained temporarily for safe migration of existing data.
  // New writes use TopicCloMapping instead.
  cloRef     String?
  hours      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  version     ProformaVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  cloMappings TopicCloMapping[]

  @@unique([versionId, orderIndex])
  @@index([versionId])
}

model TopicCloMapping {
  id      String @id @default(cuid())
  topicId String
  cloId   String

  topic CourseTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  clo   CourseLearningOutcome @relation(fields: [cloId], references: [id], onDelete: Cascade)

  @@unique([topicId, cloId])
  @@index([cloId])
}

model AssessmentItem {
  id               String          @id @default(cuid())
  versionId        String
  phase            AssessmentPhase
  orderIndex       Int
  nameMs           String
  nameEn           String?
  weightagePercent Decimal?        @db.Decimal(5, 2)
  hours            Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, phase, orderIndex])
  @@index([versionId])
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FACULTY_OFFICER
  PROGRAMME_COORDINATOR
  COURSE_COORDINATOR
  LECTURER
}

enum ProformaStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum ReviewActionType {
  SUBMIT
  REQUEST_CHANGES
  APPROVE
  PUBLISH
  ARCHIVE
  REOPEN_DRAFT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  staffNo      String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles           UserRole[]
  assignments     CourseAssignment[]
  versionsCreated ProformaVersion[] @relation("VersionCreatedBy")
  reviewActions   ReviewAction[]
  comments        ReviewComment[]
  auditEvents     AuditEvent[]
}

model UserRole {
  id          String     @id @default(cuid())
  userId      String
  role        Role
  programmeId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  programme Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@unique([userId, role, programmeId])
  @@index([role])
}

model Programme {
  id        String   @id @default(cuid())
  code      String   @unique
  nameMs    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  userRoles UserRole[]
  plos      ProgrammePlo[]
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  nameMs      String
  nameEn      String?
  creditHours Decimal  @db.Decimal(4, 1)
  programmeId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme   Programme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  assignments CourseAssignment[]
  versions    ProformaVersion[]

  @@index([programmeId])
}

model CourseAssignment {
  id            String   @id @default(cuid())
  courseId      String
  userId        String
  isCoordinator Boolean  @default(false)
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@index([userId])
}

model ProformaVersion {
  id                  String         @id @default(cuid())
  courseId            String
  versionNo           Int
  status              ProformaStatus @default(DRAFT)
  schemaFormatVersion Int            @default(1)
  payload             Json           @default("{}")
  createdById         String
  submittedAt         DateTime?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  synopsis                  String?
  academicStaffNames        String[]
  yearOffered               Int?
  semesterOffered           Int?
  offeringRemarks           String?
  prerequisite              String?
  classification            CourseClassification?
  classificationDomain      String?
  transferableSkills        String[]
  specialRequirements       String?
  referencesText            String?
  futureReadyElements       String[]
  excelFramework            String[]
  sdgTags                   String[]
  aiElement                 Boolean  @default(false)
  isIndustrialTraining50Elt Boolean  @default(false)
  facultyApprovalDate       DateTime?
  senateApprovalDate        DateTime?

  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewActions ReviewAction[]
  comments      ReviewComment[]
  auditEvents   AuditEvent[]
  clos          CourseLearningOutcome[]
  topics        CourseTopic[]
  assessments   AssessmentItem[]

  @@unique([courseId, versionNo])
  @@index([status])
  @@index([courseId, status])
}

model ReviewAction {
  id        String           @id @default(cuid())
  versionId String
  actorId   String
  type      ReviewActionType
  note      String?
  createdAt DateTime         @default(now())

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor   User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([actorId])
}

model ReviewComment {
  id         String   @id @default(cuid())
  versionId  String
  authorId   String
  sectionKey String?
  body       String
  createdAt  DateTime @default(now())

  version ProformaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([versionId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  versionId  String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor   User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version ProformaVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

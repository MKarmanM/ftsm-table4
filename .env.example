# Pooled PostgreSQL URL for the running application (required).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ftsm_table4"

# Generate each value independently, for example: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-value"
RESET_TOKEN_SECRET="replace-with-a-different-long-random-value"

# Public base URL used in notification and password-reset links.
APP_URL="http://localhost:3000"

# Optional in local development. Without these values, Ethereal test mail is used.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Table 4 FTSM <noreply@example.edu>"
